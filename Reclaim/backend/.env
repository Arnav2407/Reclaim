# Reclaim Environment Configuration
APP_NAME=Reclaim
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./reclaim.db

# Redis Queue
REDIS_URL=redis://localhost:6379/0

# Razorpay Credentials (Test mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# LLM Keys
GEMINI_API_KEY=

# Policy Guardrails Defaults
MAX_RECOVERY_ATTEMPTS=3
HIGH_VALUE_ESCALATION_THRESHOLD=50000.0
MAX_DISCOUNT_PERCENTAGE=10.0
MAX_OUTBOUND_MESSAGES=2
CONTACT_COOLDOWN_HOURS=24
